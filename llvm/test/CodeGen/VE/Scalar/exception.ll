; CHECK-NEXT:    st %s9, (, %s11)
; CHECK-NEXT:    st %s10, 8(, %s11)
; CHECK-NEXT:    .cfi_offset %s9, 0
; CHECK-NEXT:    .cfi_offset %s10, 8
